.body-desktop
  overflow hidden
  font-family 'TT Commons'
  background-color #1f252f

.mobile-desktop
  background-color #181f29

.icon-border
  size 50px
  display flex
  cursor pointer
  align-items center
  border-radius 50px
  justify-content center
  border 3px solid #f6ac6d
  background-color rgba(0, 0, 0, .15)
  transition background-color .15s ease-in-out
  +between(1000px, 1290px)
    size 45px
    border-width 2px
  & + *, .icon-bg + *
    margin-top 10px
  svg
    fill #fff
    max_size 24px
    transition fill .15s ease-in-out
  &:hover
    background-color #f6ac6d
    svg
      fill #1f252f

.icon-bg
  @extend .icon-border
  background-color #f6ac6d
  &--close
    svg
      size 17px
  svg
    fill #1f252f
  &:active
    background-color rgba(0, 0, 0, .15)
    svg
      fill #fff

.phone
  display flex
  user-select none
  align-items center
  &:hover
    text-decoration none
    .icon-bg
      @extend .icon-bg:hover
  &--black-mode:hover .icon-bg svg
    fill #1f252f
  &__number
    color #fff
    line-height 1
    font-weight 700
    overflow hidden
    margin-right 30px
    white-space nowrap
    font-size rem(20px)
    letter-spacing rem(4.4px)
    font-family 'Heading Pro Wide'
    transition opacity .15s ease-in-out, visibility .15s ease-in-out
    &--black-mode
      color #1f252f

// плавное появление и исчезновение прелоудера
.vld-overlay
  animation fadeIn .15s ease-out
  @keyframes fadeIn
    0%
      opacity 0
      display none
    1%
      opacity 0
      display block
    100%
      opacity 1
.vld-overlay--hide
  opacity 0
  transition opacity .15s ease-in-out

.fade-025-enter-active, .fade-025-leave-active
  transition opacity .25s
.fade-05-enter-active, .fade-05-leave-active
  transition opacity .25s
.fade-1s-enter-active, .fade-1s-leave-active
  transition opacity 1s
.fade-05-enter, .fade-05-leave-to, .fade-025-enter, .fade-025-leave-to, .fade-1s-enter, .fade-1s-leave-to
  opacity 0

.first-boot
  size 100%
  z-index 9999
  fixed top 0 left 0
  background-color #000

.scrollbar-thumb
  border-radius 0!important
  background #f6ac6d!important

.fancybox-thumbs
  background #1f252f

.fancybox-thumbs__list a:before
  border 3px solid #f6ac6d
.list-st
  display grid
  padding-left 18px
  @media (max-width:1024px)
    justify-content center


.bottom-right-panel
    z-index 103
    fixed bottom 55px right 80px
    +below(1800px)
      bottom 85px
    +below(1700px)
      right 35px
    +below(1023px)
      right 20px
      bottom 50px
.custom-form__agree
  line-height 1
  font-weight 300
  font-size .75rem
  padding-left 20px
  position relative
  color rgba(255, 255, 255, .75)
  a
    color #f6ac6d
  &:before
    content ''
    position absolute
    left 0
    top 0
    width 13px
    height 13px
    border 1px solid rgba(255, 255, 255, .7)
  &:after
    content ''
    position absolute
    left 5px
    top 2px
    width 4px
    height 8px
    transform rotate(45deg)
    border-right 2px solid #f6ac6d
    border-bottom 2px solid #f6ac6d
    opacity 0
    transition opacity .15s

.custom-form__checkbox
  position absolute
  left 0
  top 0
  width 13px
  height 13px
  opacity 0
  cursor pointer

.custom-form__checkbox:checked + .custom-form__agree:after
  opacity 1

.exclusive-openblock
  background #F6AC6D
  color #1F252F
  font-family 'Heading Pro Wide'
  text-transform uppercase
  font-weight 600
  font-size 12px
  line-height 18px
  display grid
  gap 10px
  padding-block 16px
  padding-inline 16px
  position relative
  z-index 10
  overflow hidden
  &__btn
    font-family 'Heading Pro Wide'
    letter-spacing 0.22em
    display inline-flex
    gap 10px
    svg
      height 16px
      width 38px
  & > *
    position relative
    z-index 1
  &__circle
    position absolute
    z-index 0
    & img
      width 100%
      height 100%
    &-1
      width 291.4978665840148px
      height 176.90135363673699px
      right -20px
      top -30px
    &-2
      width 253.4063304348962px
      height 302.8879138850838px
      right -78px
      bottom -182px
    &-3
        display none

  @media (min-width: 1024px)
    font-size 16px
    padding-inline 49px
    display flex
    justify-content space-between
    align-items center

    &__btn
      gap 32px
      background #1F252F
      color #F6AC6D
      padding 16px 20px
      border-radius 62px
      width fit-content
      cursor pointer
    &__circle
      &-1
        width 710.0330879102315px
        height 430.89792286159724px
        right 515px
        top -200px
      &-2
        display none
      &-3
        display block
        width 617.2493835344864px
        height 374.59020625056326px
        right -12px
        bottom -121px
        transformt rotate(80deg)

